# Generar una clave propia antes de iniciar Django (ver README).
# SECRET_KEY es obligatoria y no tiene valor por defecto en settings.py.
SECRET_KEY=
DEBUG=True

# Listas separadas por comas. Hosts sin esquema ni puerto; orígenes con esquema.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Producción: DEBUG=False y configurar explícitamente, por ejemplo:
# ALLOWED_HOSTS=mithoworld.yurack.com
# CSRF_TRUSTED_ORIGINS=https://mithoworld.yurack.com

DB_NAME=mithoworld_db
DB_USER=mitho_user
# Elegir una contraseña antes de inicializar el volumen de PostgreSQL.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Solo para docker-compose.prod.yml; obtener el token de tu túnel Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=
