# Generar una clave propia antes de iniciar Django (ver README).
# SECRET_KEY es obligatoria y no tiene valor por defecto en settings.py.
SECRET_KEY=
DEBUG=True

# Listas separadas por comas. Hosts sin esquema ni puerto; orígenes con esquema.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Producción: DEBUG=False y configurar explícitamente, por ejemplo:
# ALLOWED_HOSTS=mithoworld.yurack.com
# CSRF_TRUSTED_ORIGINS=https://mithoworld.yurack.com

DB_NAME=mithoworld_db
DB_USER=mitho_user
# Elegir una contraseña antes de inicializar el volumen de PostgreSQL.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Solo para docker-compose.prod.yml; obtener el token de tu túnel Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# Crónica opcional. Iniciar con docker compose -f docker-compose.prod.yml --profile ai up -d --build
# En desarrollo: uv run python manage.py procesar_cronicas
CRONICA_API_KEY=
CRONICA_MODELO=
CRONICA_TIMEOUT_S=15
CRONICA_MAX_TOKENS=256
CRONICA_RATE=3/min
CRONICA_MAX_LLAMADAS_DIA=100
# json_object para endpoints :free; json_schema si el modelo admite esquemas estrictos.
CRONICA_FORMATO=json_object
CRONICA_REQUIRE_PARAMETERS=False
